{
  "name": "foxbox",
  "productName": "FoxBox",
  "version": "1.5.4",
  "private": true,
  "description": "Voice-mask studio for GUY FVWKS: typed or recorded voice in, bar-exact club-ready drops out.",
  "author": "GUY FVWKS",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:mock": "FVWKS_MOCK=1 electron-vite dev",
    "web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.e2e.json",
    "gen:api": "openapi-typescript ../contracts/openapi.yaml -o src/renderer/src/api/schema.d.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build && playwright test",
    "package": "electron-vite build && node scripts/package.mjs",
    "install:app": "node scripts/install-app.mjs",
    "package:install": "electron-vite build && node scripts/package.mjs --install",
    "package:dmg": "electron-vite build && node scripts/package.mjs --bundle-engine --dmg",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@fontsource/big-shoulders-display": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tanstack/react-query": "^5.104.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "openapi-fetch": "^0.17.0",
    "openapi-typescript": "^7.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11",
    "zustand": "^5.0.15"
  },
  "dependencies": {
    "@dnd-kit/abstract": "^0.5.0",
    "@dnd-kit/dom": "^0.5.0",
    "@dnd-kit/react": "^0.5.0",
    "@waveform-playlist/browser": "^16.0.0",
    "@waveform-playlist/playout": "^12.5.4",
    "butterchurn": "2.6.7",
    "butterchurn-presets": "2.4.7",
    "colorthief": "3.5.0",
    "interactive-shader-format": "2.8.1",
    "postprocessing": "^6.39.5",
    "styled-components": "^6.5.3",
    "three": "^0.186.1",
    "tone": "^15.1.22",
    "troika-three-text": "0.52.5"
  }
}
